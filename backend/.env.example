# Copy to backend/.env and replace placeholders with your own values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
DAILY_MESSAGE_CAP=5
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=3
RUN_WORKER_IN_PROCESS=0

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
PINECONE_HOST=https://your-index-host

LLM_MODEL=GEMINI
GEMINI_API_KEY=your-gemini-api-key
# Required only when using Cloudflare or provider failover.
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

EXTRACT_METHOD=textract
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
TYPESAFE_API_KEY=your-typesafe-api-key
CONTEXTUAL_CHUNKING=1

# Optional observability.
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# GRAFANA_OTLP_ENDPOINT=your-endpoint
# GRAFANA_OTLP_AUTH=your-auth
# OTEL_SERVICE_NAME=document-retrieval-system
# DEPLOYMENT_ENV=development
