{
  "title": "Document Retrieval System — Overview",
  "uid": "drs-overview",
  "tags": ["document-retrieval-system"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "grafanacloud-prom", "value": "grafanacloud-prom" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Message rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(chat_messages_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Success rate (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chat_messages_total{status=\"ok\"}[1h])) / clamp_min(sum(increase(chat_messages_total[1h])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chat_messages_total{status=\"error\"}[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Messages by status (1h)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "options": { "legend": { "showLegend": true, "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(chat_messages_total[1h]))",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM spend per hour, by model",
      "type": "timeseries",
      "description": "Estimated spend. A counter, so this is rate() into $/hour — a gauge would only ever show the last answer's price.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(llm_cost_usd_total[$__rate_interval]) * 3600)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM spend (24h)",
      "type": "stat",
      "description": "A FLOOR, not an invoice: thinking tokens are included at the output rate, but a model with no entry in PRICE_PER_MTOK contributes nothing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_cost_usd_total[24h]))",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Time to first token — p50 / p95",
      "type": "timeseries",
      "description": "TTFT, not total latency. The two move independently: a fast first token with a slow stream feels nothing like the reverse, and a single total hides both.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(llm_ttft_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_ttft_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{model}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Ingest queue depth",
      "type": "timeseries",
      "description": "Backlog by status. This is the signal to scale workers on — NOT CPU: the worker is I/O-bound on Textract and Gemini, so it sits near-idle while the queue grows.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (ingest_queue_depth)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
